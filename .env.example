# Supabase PostgreSQL Connection URL (Server-side direct database connection)
# Example: postgres://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgres://postgres:password@localhost:5432/postgres

# Supabase Client API Configuration (Frontend Client)
# Note: Never put service_role key here. Only use the public client Anon Key.
VITE_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Google Gemini API Key for Dalani AI Assistant
GEMINI_API_KEY=

# Optional Google Maps Platform API Key
VITE_GOOGLE_MAPS_API_KEY=

# Server Port (Defaults to 3000)
PORT=3000

# Base URL for API requests in Production / Mobile
VITE_API_BASE_URL=